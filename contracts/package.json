{
  "name": "@ordo/contracts",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/compile.mjs",
    "test": "node scripts/compile.mjs && vitest run",
    "typecheck": "tsc --noEmit",
    "deploy:trust": "node scripts/compile.mjs && tsx scripts/deploy-trust.ts",
    "setup:hedera": "node scripts/compile.mjs && tsx scripts/hedera-setup.ts",
