{
  "name": "@ordo/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:hedera": "node --env-file=.env --import tsx scripts/smoke-hedera.ts",
    "anchor:build": "node --env-file=.env --import tsx scripts/anchor-build.ts",
    "doctor": "node --env-file-if-exists=.env --import tsx scripts/doctor.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@google/genai": "^2.30.0",
    "@hashgraph/hedera-agent-kit": "4.1.0",
    "@hiero-ledger/sdk": "^2.90.1",
    "@hono/node-server": "^2.1.5",
    "@x402/core": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/hedera": "2.28.0",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.13",
    "long": "5.3.2",
    "pg": "^8.23.1",
    "viem": "^2.57.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/pg": "^8.23.1",
    "ganache": "^7.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
