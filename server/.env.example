# ---- Core ----
PORT=8080
# Leave DATABASE_URL empty to use embedded Postgres (PGlite) in DATA_DIR. DATA_DIR=memory = no persistence.
DATABASE_URL=
DATA_DIR=.data
# Engine cycle interval for the background timer (long-running mode only)
TICK_MS=5000
# Set when the console is hosted separately, e.g. https://ordo.vercel.app
CORS_ORIGINS=
# Background timer that pulls data and advances runs: auto (on locally, off on Vercel) | on | off
ENGINE_TIMER=auto

# ---- Accounts (wallet sign-in) ----
# Only this wallet may create sites. Empty: any signed-in wallet can create its own site.
BOOTSTRAP_ADMIN_ADDRESS=
SESSION_TTL_HOURS=72
# Optional RPC so smart-contract wallets (ERC-1271 / ERC-6492) can sign in and sign decisions
AUTH_RPC_URL=
# Chain id put in EIP-712 signatures when the wallet does not report one (296 = Hedera testnet)
SIGNATURE_CHAIN_ID=296

# ---- On-chain trust: OrdoTrust (deploy with: pnpm --filter @ordo/contracts deploy:trust) ----
# All of these together turn on validator credentials and stakes on-chain; leave empty to approve validators in-app only.
TRUST_RPC_URL=
TRUST_CHAIN_ID=
TRUST_CHAIN_NAME=Hedera Testnet
TRUST_EXPLORER_URL=
TRUST_CONTRACT_ADDRESS=
# Pays gas to relay signed grants, releases and slashes. It has no authority of its own.
TRUST_RELAYER_KEY=
TRUST_SYMBOL=HBAR
# 8 on Hedera (tinybars inside the EVM), 18 on other chains
TRUST_DECIMALS=8
# OrdoWorkOrders (the maintenance agent escrows vendor payments) and OrdoPolicies (two plant managers to raise
# autonomy), both bound to OrdoTrust. Created by the "Hedera setup" workflow (contracts).
TRUST_WORKORDERS_ADDRESS=
TRUST_POLICIES_ADDRESS=

# ---- World ID: one person per validator seat at a site ----
# From the World Developer Portal. sandbox verifies with the World ID Sandbox test build of World App. Create the action
# with unlimited verifications per person; the signing key stays on the server.
WORLD_ID_APP_ID=
WORLD_ID_RP_ID=
WORLD_ID_SIGNING_KEY=
WORLD_ID_ACTION=ordo-validator
WORLD_ID_ENVIRONMENT=sandbox

# ---- AI agents: offline | gemini | openai_compat | 0g ----
LLM_PROVIDER=offline
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ---- Ledger anchoring: local | hedera ----
ANCHOR=local
# Ed25519 PKCS8 DER, base64. Generate with:
# node -e "const{generateKeyPairSync}=require('crypto');console.log(generateKeyPairSync('ed25519').privateKey.export({format:'der',type:'pkcs8'}).toString('base64'))"
LEDGER_SIGNING_KEY=
# Anchor the ledger head after this many new entries (and at least every 30 minutes)
ANCHOR_EVERY=50

# ---- Partner rails (see contracts/README.md) ----
# IDENTITY: plain | ens (shows people's primary ENS names)
IDENTITY=plain

# Hedera: the operator submits ledger anchors to HEDERA_TOPIC_ID (with ANCHOR=hedera) and agent audit entries.
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TOPIC_ID=
HEDERA_BUILD_TOPIC_ID=
# The maintenance agent's own account. It escrows work order payments in OrdoWorkOrders; with HEDERA_AGENT_ID on a
# Hedera chain it does so through Hedera Agent Kit. Created by the "Hedera setup" workflow (agent).
HEDERA_AGENT_ID=
HEDERA_AGENT_KEY=
# Lot passports: the HTS NFT collection ("Hedera setup" workflow, passport). The operator mints one NFT per lot.
HEDERA_PASSPORT_TOKEN_ID=
# Deadlines on Hedera's Schedule Service (on whenever the operator is set): escrow refunds and validator payouts
# need OrdoTrust/OrdoWorkOrders on Hedera; stage timeouts need HEDERA_TOPIC_ID. "off" leaves them to the server.
HEDERA_SCHEDULES=on
# x402: Ordo sells vibration assessments at POST /v1/x402/vibration-assessment, paid in HBAR through an x402
# facilitator (fees to X402_PAY_TO, default the operator). With HEDERA_AGENT_ID, the agent buys one per work order
# from X402_ASSESSMENT_URL (default this deployment's PUBLIC_URL), paying at most X402_MAX_TINYBARS a call.
X402_PAY_TO=
X402_PRICE_TINYBARS=10000000
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_ASSESSMENT_URL=
X402_MAX_TINYBARS=50000000
# Public base URL for passport links and QR codes (on Vercel the production domain is used when this is empty)
PUBLIC_URL=

# Ethereum mainnet RPC for ENS reverse resolution (a public default is used when empty)
ENS_RPC_URL=
# ENSv2 names on Sepolia, from the ENS setup workflow: the parent name, its UserRegistry, Ordo's resolver, and the
# key that administers them. The site, its people, assets and agents get names under the parent.
ENS_PARENT_NAME=
ENS_REGISTRY_ADDRESS=
ENS_RESOLVER_ADDRESS=
ENS_OWNER_KEY=
ENS_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# OrdoEnsRoles and OrdoLotResolver (ENS setup workflow, `contracts <url>`): contracts read roles from member names,
# and every lot gets a lot-<order>.<site>.<parent> name answered by this app's CCIP-Read gateway. Set both or neither.
ENS_ROLES_ADDRESS=
ENS_LOT_RESOLVER_ADDRESS=

# 0G Galileo testnet (chain 16602). EVIDENCE_STORE=0g copies evidence to 0G Storage, encrypted; LLM_PROVIDER=0g runs
# diagnosis on 0G Compute (needs a funded compute ledger) and checks each answer's TEE signature.
EVIDENCE_STORE=local
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
ZG_PRIVATE_KEY=
ZG_PROVIDER_ADDRESS=
# OrdoAgentNFT on 0G Galileo (from the 0G setup workflow): each agent of each site is an ERC-7857 iNFT
ZG_INFT_ADDRESS=
