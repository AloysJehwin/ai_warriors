# ---- Core ----
PORT=8080
# Leave DATABASE_URL empty to use embedded Postgres (PGlite) in DATA_DIR. DATA_DIR=memory = no persistence.
DATABASE_URL=
DATA_DIR=.data
# Engine cycle interval for the background timer (long-running mode only)
TICK_MS=5000
# Set when the console is hosted separately, e.g. https://ordo.vercel.app
CORS_ORIGINS=
# Background timer that pulls data and advances runs: auto (on locally, off on Vercel) | on | off
ENGINE_TIMER=auto

# ---- Accounts (wallet sign-in) ----
# Only this wallet may create sites. Empty: any signed-in wallet can create its own site.
BOOTSTRAP_ADMIN_ADDRESS=
SESSION_TTL_HOURS=72
# Optional RPC so smart-contract wallets (ERC-1271 / ERC-6492) can sign in and sign decisions
AUTH_RPC_URL=
# Chain id put in EIP-712 signatures when the wallet does not report one (296 = Hedera testnet)
SIGNATURE_CHAIN_ID=296

# ---- AI agents: offline | gemini | openai_compat | 0g ----
LLM_PROVIDER=offline
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ---- Ledger anchoring: local | hedera ----
ANCHOR=local
# Ed25519 PKCS8 DER, base64. Generate with:
# node -e "const{generateKeyPairSync}=require('crypto');console.log(generateKeyPairSync('ed25519').privateKey.export({format:'der',type:'pkcs8'}).toString('base64'))"
LEDGER_SIGNING_KEY=
# Anchor the ledger head after this many new entries (and at least every 30 minutes)
ANCHOR_EVERY=50

# ---- Partner rails (see contracts/README.md) ----
# PAYMENTS: mock | hedera · IDENTITY: plain | ens (shows people's primary ENS names)
PAYMENTS=mock
IDENTITY=plain

HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TOPIC_ID=
HEDERA_BUILD_TOPIC_ID=
HEDERA_AGENT_ID=
HEDERA_AGENT_KEY=
HEDERA_VENDOR_ID=
HEDERA_VENDOR_EVM=
HEDERA_VAULT_ADDRESS=
HEDERA_POLICY_REGISTRY_ADDRESS=
HEDERA_JSON_RPC_URL=https://testnet.hashio.io/api

# Ethereum mainnet RPC for ENS reverse resolution (a public default is used when empty)
ENS_RPC_URL=

ZG_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
ZG_PRIVATE_KEY=
ZG_PROVIDER_ADDRESS=
