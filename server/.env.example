# ---- Core ----
PORT=8080
# Leave DATABASE_URL empty to use embedded Postgres (PGlite) in DATA_DIR. DATA_DIR=memory = no persistence.
DATABASE_URL=
DATA_DIR=.data
SIM_SEED=42
SIM_SCENARIO=bearing_wear
SIM_AUTOSTART=false
TICK_MS=1000
LINE_AUTONOMY=L3
# Set when the console is hosted separately, e.g. https://ordo.vercel.app
CORS_ORIGINS=
# Shared passcode for every change (POST/PATCH). Strongly recommended on any public URL.
DEMO_PASSCODE=
# Background timer that advances the plant: auto (on locally, off on Vercel) | on | off
ENGINE_TIMER=auto

# ---- AI agents: offline | gemini | openai_compat | 0g ----
LLM_PROVIDER=offline
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ---- Ledger anchoring: local | hedera ----
ANCHOR=local
# Ed25519 PKCS8 DER, base64. Generate with:
# node -e "const{generateKeyPairSync}=require('crypto');console.log(generateKeyPairSync('ed25519').privateKey.export({format:'der',type:'pkcs8'}).toString('base64'))"
LEDGER_SIGNING_KEY=

# ---- Partner rails (see contracts/README.md) ----
# APPROVALS: app | hedera · PAYMENTS: mock | hedera · IDENTITY: plain | ens · EVIDENCE_STORE: local | 0g
APPROVALS=app
PAYMENTS=mock
IDENTITY=plain
EVIDENCE_STORE=local

HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TOPIC_ID=
HEDERA_BUILD_TOPIC_ID=
HEDERA_ROLE_ACCOUNTS=
HEDERA_AGENT_ID=
HEDERA_AGENT_KEY=
HEDERA_VENDOR_ID=
HEDERA_VENDOR_EVM=
HEDERA_VAULT_ADDRESS=
HEDERA_POLICY_REGISTRY_ADDRESS=
HEDERA_JSON_RPC_URL=https://testnet.hashio.io/api

ENS_RPC_URL=
ENS_PARENT_NAME=

ZG_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
ZG_PRIVATE_KEY=
ZG_PROVIDER_ADDRESS=
