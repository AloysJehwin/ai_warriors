{
  "name": "ordo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ordo/server --filter @ordo/web dev",
    "build": "pnpm --filter @ordo/web build && pnpm --filter @ordo/server build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "start": "pnpm --filter @ordo/server start",
    "e2e": "playwright test",
    "vercel-build": "node scripts/vercel-build.mjs",
    "vercel-local": "node scripts/vercel-local.mjs",
    "env:doctor": "pnpm --filter @ordo/server doctor",
    "env:vercel": "node scripts/vercel-env.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2"
  }
}
