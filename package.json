{
  "name": "ordo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ordo/server --filter @ordo/web dev",
    "build": "pnpm --filter @ordo/web build && pnpm --filter @ordo/server build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "start": "pnpm --filter @ordo/server start",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
